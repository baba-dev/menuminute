# HTTPS food.bababuilds.com server location sample. NEVER replace the entire vhost.
# Preserve ERP coexistence, trusted Cloudflare real_ip and existing order attestation.
location / {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 60s;
    client_max_body_size 1m;
}

location ^~ /api/auth/ {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    add_header Cache-Control "private, no-store" always;
    proxy_read_timeout 60s;
    client_max_body_size 16k;
}

# Public guest-order submission and tracking require signed proxy identity.
location ^~ /api/public-orders {
    include /etc/menuminute/nginx-order-edge-secret.conf;
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-MenuMinute-Client-IP $remote_addr;
    proxy_set_header X-MenuMinute-Edge-Key $menuminute_edge_secret;
    proxy_read_timeout 60s;
    client_max_body_size 128k;
    add_header Cache-Control "private, no-store" always;
}

# 5 MiB image uploads + transfer overhead; other paths retain the 1 MiB default.
# The original binary upload is POST /api/media (without trailing slash).
location = /api/media {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 6m;
    proxy_read_timeout 60s;
}
location ^~ /api/media/ {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 6m;
    proxy_read_timeout 60s;
}
location ^~ /api/menu-imports/ {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 6m;
    proxy_read_timeout 60s;
}

# Public menu reads use the same proxy-attested source reservation as guest
# order tracking. The proxy must overwrite both private headers; never forward
# client-supplied values. This reference block does not replace the live vhost.
location ^~ /api/public-menu/ {
    include /etc/menuminute/nginx-order-edge-secret.conf;
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-MenuMinute-Client-IP $remote_addr;
    proxy_set_header X-MenuMinute-Edge-Key $menuminute_edge_secret;
    proxy_read_timeout 30s;
    client_max_body_size 16k;
    add_header Cache-Control "private, no-store" always;
}

# Internal-only bytes transport: NEVER expose this location to clients.
# Before enabling, verify MEDIA_ROOT=/var/lib/menuminute/media and access
# for the Nginx worker user/group. No regex/globs or public filesystem mapping.
# This preserves API-driven database authorization, rate limiting and ETag checks.
location ^~ /_menuminute_media_internal/ {
    internal;
    alias /var/lib/menuminute/media/;
    autoindex off;
    default_type image/webp;
    add_header Cache-Control "private, no-cache, max-age=0, must-revalidate" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "default-src 'none'; sandbox" always;
}

# The PUBLIC /api/public-media/[mediaId] route must continue proxying to
# Next.js, which verifies publication, approval, tenant scope and rate limits.
# Do not add a public direct-file location or public immutable caching.
location ^~ /api/public-media/ {
    include /etc/menuminute/nginx-order-edge-secret.conf;
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-MenuMinute-Client-IP $remote_addr;
    proxy_set_header X-MenuMinute-Edge-Key $menuminute_edge_secret;
    proxy_read_timeout 30s;
    client_max_body_size 16k;
    add_header Cache-Control "private, no-cache, max-age=0, must-revalidate" always;
}

# Host-only activation (AFTER nginx -t, nginx reload and ERP /health smoke):
#  MEDIA_X_ACCEL_REDIRECT_ENABLED=true
# Keep false for R2 deployments, local tests, and hosts without this alias.
