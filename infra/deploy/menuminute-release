#!/usr/bin/env bash
# Installed once as root: /usr/local/sbin/menuminute-release (root:root, 0750).
# The SSH deploy account can only invoke this audited entry point through sudo.
set -Eeuo pipefail
umask 027

if [[ "${1:-}" == --version && "$#" -eq 1 ]]; then
  echo 4
  exit 0
fi

[[ "$EUID" -eq 0 ]] || { echo "Root is required" >&2; exit 1; }
[[ "$#" -eq 3 ]] || { echo "Usage: menuminute-release stage|eligibility|activate|autoactivate|verify|recover SHA256_COMMIT SHA256_ARCHIVE" >&2; exit 2; }
mode="$1"; sha="$2"; digest="$3"
# Legacy manual activation now takes the same checked, unattended path.
[[ "$mode" != activate ]] || mode=autoactivate
[[ "$mode" == stage || "$mode" == eligibility || "$mode" == activate || "$mode" == autoactivate || "$mode" == verify || "$mode" == recover ]] || {
  echo "Unsupported release mode; install the reviewed current helper" >&2; exit 2;
}
[[ "$sha" =~ ^[0-9a-f]{40}$ && "$digest" =~ ^[0-9a-f]{64}$ ]] || { echo "Invalid release identity" >&2; exit 2; }

node24=/opt/menuminute/node24/bin/node
root=/var/www/menuminute
data=/var/lib/menuminute
release="$root/releases/$sha"
incoming="$data/incoming/$sha.tar.gz"
web_link="$root/current"
worker_link="$root/worker-current"
lock=/run/lock/menuminute-release.lock
exec 9>"$lock"
flock -n 9 || { echo "Another MenuMinute deployment is running" >&2; exit 1; }

[[ "$(uname -m)" == aarch64 ]] || { echo "Native ARM64 host required" >&2; exit 1; }
[[ -x "$node24" ]] || { echo "Private MenuMinute Node 24 is missing" >&2; exit 1; }
[[ "$("$node24" -p 'process.versions.node.split(".")[0] + ":" + process.arch')" == "24:arm64" ]] || {
  echo "Node 24 ARM64 required on host" >&2; exit 1;
}
[[ -d "$root/releases" && -d "$data/incoming" ]] || { echo "Run the server bootstrap first" >&2; exit 1; }

verify_release() {
  [[ -d "$release" && ! -L "$release" ]] || { echo "Release is not staged" >&2; return 1; }
  [[ "$(cat "$release/RELEASE-SHA")" == "$sha" ]] || return 1
  [[ "$(cat "$release/.release-archive-sha256")" == "$digest" ]] || return 1
  [[ -f "$release/.next/standalone/server.js" && -f "$release/dist/worker.mjs" &&
     -f "$release/dist/db-migrate.mjs" && -f "$release/src/db/migrations/meta/_journal.json" ]] || return 1
}

# Root can read a broken 0750 release; verify the two *actual* service users
# can enter their WorkingDirectory and read the main entry points before any
# application symlink is changed. This guards against systemd 200/CHDIR.
runtime_access_ok() {
  runuser -u menuminute -- sh -c '
    cd "$1" &&
    test -r .next/standalone/server.js &&
    test -r .next/standalone/.next/BUILD_ID
  ' _ "$release" &&
  runuser -u menuminute-worker -- sh -c '
    cd "$1" &&
    test -r dist/worker.mjs &&
    test -r node_modules/bullmq/package.json
  ' _ "$release"
}

if [[ "$mode" == stage ]]; then
  if [[ -e "$release" ]]; then
    if verify_release; then
      runtime_access_ok || { echo "Staged release is unreadable by runtime service users" >&2; exit 1; }
      echo "Already staged: $sha"
      exit 0
    fi
    echo "Existing release directory has a different identity; refusing overwrite" >&2
    exit 1
  fi
  [[ -f "$incoming" && ! -L "$incoming" ]] || { echo "Uploaded artifact not found" >&2; exit 1; }
  [[ "$(stat -c %U "$incoming")" == menuminute-deploy ]] || { echo "Unexpected artifact owner" >&2; exit 1; }
  available="$(df -Pm "$root" | awk 'NR==2 {print $4}')"
  [[ "$available" =~ ^[0-9]+$ && "$available" -ge 4096 ]] || {
    echo "At least 4 GiB free disk is required for safe staging" >&2; exit 1;
  }
  temp="$(mktemp -d "$root/releases/.stage.XXXXXXXX")"
  trap 'rm -rf -- "$temp"' EXIT
  # Copy away from deploy-user-writable incoming before verification/extraction.
  cp -- "$incoming" "$temp/archive.tar.gz"
  [[ "$(sha256sum "$temp/archive.tar.gz" | cut -d" " -f1)" == "$digest" ]] || {
    echo "Release checksum mismatch" >&2; exit 1;
  }
  # Validate every path and link target before GNU tar sees the archive.
  # Reject traversal, absolute links, special files, symlink-parent extraction,
  # duplicate entries and unbounded expansion. Relative pnpm links are allowed.
  python3 - "$temp/archive.tar.gz" <<'ARCHIVE'
import sys, tarfile, posixpath
members = {}
total = 0
with tarfile.open(sys.argv[1], "r:gz") as archive:
    for member in archive:
        raw = member.name
        path = posixpath.normpath(raw)
        if raw.startswith("/") or ".." in raw.split("/") or path.startswith("../"):
            raise SystemExit("Unsafe archive member path")
        if path == ".":
            if not member.isdir():
                raise SystemExit("Invalid archive root")
            continue
        if path in members or len(members) >= 250000 or member.mode & 0o6000:
            raise SystemExit("Duplicate, oversized or privileged archive entry")
        if not (member.isfile() or member.isdir() or member.issym() or member.islnk()):
            raise SystemExit("Archive contains special file")
        parent = posixpath.dirname(path)
        while parent not in ("", "."):
            if parent in members and members[parent].issym():
                raise SystemExit("Archive writes through symlink parent")
            parent = posixpath.dirname(parent)
        if member.issym() or member.islnk():
            link = member.linkname
            target = posixpath.normpath(
                link if member.islnk() else posixpath.join(posixpath.dirname(path), link)
            )
            if not link or link.startswith("/") or target == ".." or target.startswith("../"):
                raise SystemExit("Archive link escapes release root")
            if member.islnk() and (target not in members or not members[target].isfile()):
                raise SystemExit("Hardlink must reference an earlier regular file")
        total += member.size if member.isfile() else 0
        if total > 3 * 1024**3:
            raise SystemExit("Archive expands past 3 GiB")
        members[path] = member
    for path, member in members.items():
        parent = posixpath.dirname(path)
        while parent not in ("", "."):
            if parent in members and members[parent].issym():
                raise SystemExit("Symlink parent detected")
            parent = posixpath.dirname(parent)
ARCHIVE
  mkdir "$temp/content"
  tar -xzf "$temp/archive.tar.gz" --no-same-owner --no-same-permissions -C "$temp/content"
  [[ "$(cat "$temp/content/RELEASE-SHA")" == "$sha" ]] || { echo "Release SHA mismatch" >&2; exit 1; }
  [[ -f "$temp/content/.next/standalone/server.js" && -f "$temp/content/dist/worker.mjs" &&
     -f "$temp/content/dist/db-migrate.mjs" ]] || { echo "Incomplete release" >&2; exit 1; }
  (
    cd "$temp/content"
    "$node24" -e 'require("pg"); require("bullmq"); require("sharp")'
    "$node24" --check dist/worker.mjs
    "$node24" --check dist/db-migrate.mjs
  )
  [[ -d "$data/cache" && -d "$temp/content/.next/standalone/.next" ]] || {
    echo "Provision /var/lib/menuminute/cache before staging" >&2; exit 1;
  }
  rm -rf -- "$temp/content/.next/standalone/.next/cache"
  ln -s "$data/cache" "$temp/content/.next/standalone/.next/cache"
  printf '%s\n' "$digest" > "$temp/content/.release-archive-sha256"
  chown -R root:root "$temp/content"
  # The global umask 027 makes a newly-created release root:root 0750 and
  # extracted files 0640. Both service accounts then fail 200/CHDIR/read.
  # This archive contains only published app code/assets (never env/secrets):
  # normalize directory traversal and file reads; preserve executable bits.
  # GNU chmod -R does not dereference symlinks encountered inside the tree,
  # including the intentionally shared persistent .next/cache target.
  chmod -R u=rwX,go=rX "$temp/content"
  mv -T -- "$temp/content" "$release"
  runtime_access_ok || { echo "Staged release is unreadable by runtime service users" >&2; exit 1; }
  echo "Verified native ARM64 release staged: $sha"
  exit 0
fi

verify_release || { echo "Staged release identity verification failed" >&2; exit 1; }
runtime_access_ok || {
  echo "Runtime accounts cannot enter/read the staged release; refusing cutover" >&2; exit 1;
}
[[ -f /etc/menuminute/web.env && -f /etc/menuminute/worker.env ]] || {
  echo "Runtime environment files are not provisioned" >&2; exit 1;
}
systemctl cat menuminute-web.service >/dev/null
systemctl cat menuminute-worker.service >/dev/null
# Do not redirect live traffic into a release started with the old ERP Node runtime.
for unit in menuminute-web.service menuminute-worker.service; do
  systemctl show "$unit" --property=ExecStart --value | grep -Fq "$node24" || {
    echo "$unit must use the private MenuMinute Node 24 before activation" >&2; exit 1;
  }
done
nginx -t >/dev/null
[[ ! -e "$web_link" || -L "$web_link" ]] || { echo "current must be a symlink" >&2; exit 1; }
[[ ! -e "$worker_link" || -L "$worker_link" ]] || { echo "worker-current must be a symlink" >&2; exit 1; }
old_web="$(readlink "$web_link" || true)"
old_worker="$(readlink "$worker_link" || true)"
[[ "$old_web" == "$old_worker" ]] || { echo "Web and worker releases are out of sync" >&2; exit 1; }
if [[ -n "$old_web" ]]; then
  [[ "$old_web" == "$root/releases/"* && -d "$old_web" ]] || {
    echo "Existing release path is unexpected" >&2; exit 1;
  }
  old_sha="${old_web##*/}"
  [[ "$old_sha" =~ ^[0-9a-f]{40}$ && "$(cat "$old_web/RELEASE-SHA")" == "$old_sha" ]] || {
    echo "Existing release identity cannot be established" >&2; exit 1;
  }
fi

# Only append-only, checksummed migration histories may deploy unattended.
# Existing migration SQL and metadata cannot be rewritten or removed. A new
# journal entry requires a new SQL file, and the runner locks/checksums every
# transaction. Never infer compatibility from just a changed tree hash.
migration_trees_identical() {
  local previous="$1" candidate="$2"
  [[ -d "$previous/src/db/migrations" && -d "$candidate/src/db/migrations" &&
     ! -L "$previous/src/db/migrations" && ! -L "$candidate/src/db/migrations" ]] &&
    diff -qr -- "$previous/src/db/migrations" "$candidate/src/db/migrations" >/dev/null
}

migration_change=unchanged
if [[ "$mode" == autoactivate || "$mode" == eligibility ]]; then
  [[ -n "$old_web" && -d "$old_web/src/db/migrations" &&
     ! -L "$old_web/src/db/migrations" ]] || {
    echo "An existing immutable migration history is required" >&2; exit 1;
  }
  migration_change="$(python3 - "$old_web/src/db/migrations" "$release/src/db/migrations" <<'PY'
import json, pathlib, re, sys
old, new = map(pathlib.Path, sys.argv[1:])
def read_history(root):
    if not root.is_dir() or root.is_symlink():
        raise SystemExit("Missing or linked migration root")
    journal = root / "meta/_journal.json"
    if journal.is_symlink() or not journal.is_file():
        raise SystemExit("Missing regular migration journal")
    entries = json.loads(journal.read_text())["entries"]
    names = [entry["tag"] for entry in entries]
    if not names or len(names) != len(set(names)) or any(
        not re.fullmatch(r"[0-9]{4}_[A-Za-z0-9_]+", name) for name in names
    ):
        raise SystemExit("Invalid migration journal")
    for name in names:
        sql = root / (name + ".sql")
        if sql.is_symlink() or not sql.is_file() or not sql.stat().st_size:
            raise SystemExit("Missing regular SQL migration: " + name)
    return names
previous, candidate = read_history(old), read_history(new)
if candidate[:len(previous)] != previous:
    raise SystemExit("Migration journal is not append-only")
for path in old.rglob("*"):
    rel = path.relative_to(old)
    if rel == pathlib.Path("meta/_journal.json"):
        continue
    other = new / rel
    if path.is_symlink() or other.is_symlink():
        raise SystemExit("Migration history contains a symlink")
    if path.is_dir():
        if not other.is_dir():
            raise SystemExit("Existing migration directory removed")
    elif not path.is_file() or not other.is_file() or path.read_bytes() != other.read_bytes():
        raise SystemExit("Existing migration content modified or removed: " + str(rel))
print("changed" if len(candidate) > len(previous) else "unchanged")
PY
)"
  systemctl is-active --quiet menuminute-web.service
  systemctl is-active --quiet menuminute-worker.service
  baseline="$(curl --silent --show-error --fail --max-time 5 http://127.0.0.1:3100/api/health/ready)"
  [[ "$baseline" == *'"status":"ready"'* ]] || {
    echo "Current release is not ready; refusing automatic cutover" >&2; exit 1;
  }
  if [[ "$migration_change" == changed ]]; then
    owner_env=/etc/menuminute/migration.env
    backup_tool=/usr/local/sbin/menuminute-restic
    [[ -f "$owner_env" && ! -L "$owner_env" &&
       "$(stat -c '%U:%a' "$owner_env")" == root:600 ]] || {
      echo "AUTO_MIGRATION_SETUP_REQUIRED: Provision root-only migration.env" >&2; exit 1;
    }
    [[ -x "$backup_tool" ]] && command -v pg_dump >/dev/null &&
      command -v pg_restore >/dev/null || {
      echo "AUTO_MIGRATION_SETUP_REQUIRED: PostgreSQL clients and off-host restic wrapper required" >&2; exit 1;
    }
  fi
fi

erp_healthy() {
  local status
  status="$(curl -sS -o /dev/null --max-time 7 -w '%{http_code}' http://127.0.0.1:3000/)" || return 1
  [[ "$status" =~ ^[23][0-9]{2}$ ]]
}
erp_healthy || { echo "ERP preflight failed; no changes applied" >&2; exit 1; }

if [[ "$mode" == eligibility ]]; then
  echo "ELIGIBLE: append-only migration history ($migration_change), healthy existing release and ERP"
  exit 0
fi
if [[ "$mode" == verify ]]; then
  [[ "$old_web" == "$release" && "$old_worker" == "$release" ]] || {
    echo "Web/worker active SHA differs from expected release" >&2; exit 1;
  }
  systemctl is-active --quiet menuminute-web.service
  systemctl is-active --quiet menuminute-worker.service
  curl --fail --silent --show-error --max-time 5 http://127.0.0.1:3100/api/health/live |
    python3 -c 'import json,sys; assert json.load(sys.stdin)["status"] == "alive"'
  curl --fail --silent --show-error --max-time 5 http://127.0.0.1:3100/api/health/ready |
    python3 -c 'import json,sys; j=json.load(sys.stdin); assert j["status"]=="ready" and j["database"] and j["redis"]["queue"] and j["redis"]["cache"]'
  echo "VERIFIED: $sha; MenuMinute web, worker, PostgreSQL, queue/cache and ERP ready"
  exit 0
fi

# Only migration-free automatic cutovers retain an application-only recovery
# pointer. Never roll back SQL, new business data, or a migration-changing app.
rollback_root="$data/rollback-pointers"
if [[ "$mode" == recover ]]; then
  [[ "$old_web" == "$release" && "$old_worker" == "$release" ]] || {
    echo "Candidate is no longer the active paired release" >&2; exit 1;
  }
  pointer="$rollback_root/$sha"
  [[ -f "$pointer" && ! -L "$pointer" && "$(stat -c '%U:%a' "$pointer")" == "root:600" ]] || {
    echo "Missing verified root-owned automatic rollback pointer" >&2; exit 1;
  }
  previous_sha="$(cat "$pointer")"
  [[ "$previous_sha" =~ ^[0-9a-f]{40}$ && "$previous_sha" != "$sha" ]] || exit 1
  previous="$root/releases/$previous_sha"
  [[ -d "$previous" && ! -L "$previous" && "$(cat "$previous/RELEASE-SHA")" == "$previous_sha" ]] || exit 1
  migration_trees_identical "$previous" "$release" || {
    echo "Schema-incompatible automatic recovery refused" >&2; exit 1;
  }
fi

switch_link() {
  local link="$1" target="$2" next="${1}.next.$$"
  ln -s "$target" "$next"
  mv -Tf -- "$next" "$link"
}

if [[ "$mode" == recover ]]; then
  # Only the previously verified compatible application can be restored.
  switch_link "$web_link" "$previous"
  switch_link "$worker_link" "$previous"
  systemctl reset-failed menuminute-web.service menuminute-worker.service
  systemctl restart menuminute-web.service menuminute-worker.service
  systemctl is-active --quiet menuminute-web.service
  systemctl is-active --quiet menuminute-worker.service
  recovered=false
  for i in {1..10}; do
    if curl --silent --show-error --fail --max-time 4 http://127.0.0.1:3100/api/health/ready |
      python3 -c 'import json,sys; j=json.load(sys.stdin); assert j["status"]=="ready" and j["database"] and j["redis"]["queue"] and j["redis"]["cache"]' 2>/dev/null; then
      recovered=true
      break
    fi
    sleep 2
  done
  [[ "$recovered" == true ]] && erp_healthy || { echo "Emergency: application recovery failed verification" >&2; exit 1; }
  echo "RECOVERED: restored previously healthy compatible release $previous_sha"
  exit 0
fi

# Repeated delivery of the already-live release performs verification only.
if [[ "$old_web" == "$release" && "$old_worker" == "$release" ]]; then
  systemctl is-active --quiet menuminute-web.service
  systemctl is-active --quiet menuminute-worker.service
  curl --silent --show-error --fail --max-time 5 http://127.0.0.1:3100/api/health/ready |
    python3 -c 'import json,sys; assert json.load(sys.stdin)["status"]=="ready"'
  echo "ALREADY_ACTIVE: $sha"
  exit 0
fi
# Migration-changing releases are backed up off-host *before* applying new SQL.
# Backups are encrypted by the provisioned restic wrapper. A new remote snapshot
# must be visible; a locally written dump or a stale snapshot is not sufficient.
# Rollback of migrated SQL/data is never automatic.
if [[ "$mode" == autoactivate && "$migration_change" == changed ]]; then
  backup_dir="$(mktemp -d "$data/.predeploy.XXXXXXXX")"
  chmod 0700 "$backup_dir"
  trap 'rm -rf -- "$backup_dir"' EXIT
  printf 'candidate=%s\nprevious=%s\narchive_sha256=%s\n' "$sha" "$old_sha" "$digest" > "$backup_dir/release.txt"
  cp -- /etc/menuminute/web.env /etc/menuminute/worker.env "$backup_dir/"
  set -a
  # Root-controlled, mode 0600 file; never load this in the runtime services or Actions.
  source "$owner_env"
  set +a
  [[ "$MIGRATION_DATABASE_URL" =~ ^postgres(ql)?:// ]] || {
    echo "Invalid explicit migration-owner URL" >&2; exit 1;
  }
  python3 - "$backup_dir/database.dump" <<'PY'
import os, subprocess, sys
from urllib.parse import urlsplit, unquote, parse_qs
url = urlsplit(os.environ["MIGRATION_DATABASE_URL"])
if url.scheme not in ("postgres", "postgresql") or not url.hostname or not url.username or not url.path.lstrip("/"):
    raise SystemExit("Invalid migration-owner connection")
env = os.environ.copy()
env.pop("MIGRATION_DATABASE_URL", None)
env.update(PGHOST=url.hostname, PGPORT=str(url.port or 5432),
           PGUSER=unquote(url.username), PGPASSWORD=unquote(url.password or ""),
           PGDATABASE=unquote(url.path.lstrip("/")), PGCONNECT_TIMEOUT="5")
options = parse_qs(url.query)
if "sslmode" in options:
    env["PGSSLMODE"] = options["sslmode"][0]
subprocess.run(["pg_dump", "--format=custom", "--no-owner", "--no-acl",
                "--file", sys.argv[1]], env=env, check=True)
PY
  test -s "$backup_dir/database.dump"
  pg_restore -l "$backup_dir/database.dump" >/dev/null
  tag="menuminute-predeploy-$sha"
  before="$("$backup_tool" snapshots --json --tag "$tag" | python3 -c 'import json,sys; print(" ".join(sorted(s["id"] for s in json.load(sys.stdin))))')"
  # Capture the private media pool as well as the DB and stable environment.
  "$backup_tool" backup --tag "$tag" "$backup_dir" "$data/media"
  after="$("$backup_tool" snapshots --json --tag "$tag" | python3 -c 'import json,sys; print(" ".join(sorted(s["id"] for s in json.load(sys.stdin))))')"
  [[ -n "$after" && "$after" != "$before" ]] || {
    echo "No new off-host snapshot verified; migration blocked" >&2; exit 1;
  }
  echo "OFF_HOST_PREDEPLOY_BACKUP_VERIFIED: $tag"
  (cd "$release" && "$node24" dist/db-migrate.mjs)
  unset MIGRATION_DATABASE_URL
  echo "AUTOMATIC_MIGRATIONS_APPLIED: $sha"
fi

if [[ "$mode" == autoactivate && "$migration_change" == unchanged ]]; then
  install -d -o root -g root -m 0700 "$rollback_root"
  pointer="$rollback_root/$sha"
  [[ ! -L "$pointer" ]] || { echo "Unsafe rollback pointer" >&2; exit 1; }
  printf '%s\n' "$old_sha" > "$pointer"
  chown root:root "$pointer"
  chmod 0600 "$pointer"
fi

echo "PREVIOUS_RELEASE=${old_sha:-none}"
switched=false
restore_previous() {
  trap - ERR
  if [[ "$switched" == true ]]; then
    if [[ -n "$old_web" ]]; then
      # Manual activation may follow an irreversible database migration. The
      # ERR trap must obey the same compatibility policy as explicit recover.
      if ! migration_trees_identical "$old_web" "$release"; then
        echo "EMERGENCY: Refusing automatic restoration to a potentially schema-incompatible previous release. Inspect MenuMinute links/services and resolve forward; database and data were not rolled back." >&2
        return 0
      fi
      echo "Release activation failed; restoring schema-compatible previous application links" >&2
      switch_link "$web_link" "$old_web"
      switch_link "$worker_link" "$old_worker"
      # A failed new release may have exhausted StartLimitBurst. Clear only
      # these two MenuMinute units before restoring the previous application.
      if ! systemctl reset-failed menuminute-web.service menuminute-worker.service; then
        echo "WARNING: Could not clear MenuMinute restart limit" >&2
      fi
      if ! systemctl restart menuminute-web.service menuminute-worker.service; then
        echo "Emergency: previous MenuMinute services failed to restart" >&2
      fi
      if ! systemctl is-active --quiet menuminute-web.service ||
         ! systemctl is-active --quiet menuminute-worker.service ||
         ! curl --silent --fail --max-time 8 http://127.0.0.1:3100/api/health/ready >/dev/null; then
        echo "Emergency: previous MenuMinute release health is NOT verified" >&2
      fi
    else
      rm -f -- "$web_link" "$worker_link"
      systemctl stop menuminute-web.service menuminute-worker.service || true
    fi
  fi
}
trap restore_previous ERR
switched=true
switch_link "$web_link" "$release"
switch_link "$worker_link" "$release"
systemctl restart menuminute-web.service menuminute-worker.service
ready=false
for i in {1..15}; do
  if systemctl is-active --quiet menuminute-web.service &&
     systemctl is-active --quiet menuminute-worker.service; then
    body="$(curl --silent --show-error --fail --max-time 5 http://127.0.0.1:3100/api/health/ready)" || {
      sleep 2
      continue
    }
    if [[ "$body" == *'"status":"ready"'* ]]; then
      ready=true
      break
    fi
  fi
  sleep 2
done
[[ "$ready" == true ]] || { echo "MenuMinute readiness failed" >&2; false; }
erp_healthy || { echo "ERP postflight failed" >&2; false; }
# Both identities are checked while rollback protection is still active.
test "$(cat "$web_link/RELEASE-SHA")" = "$sha"
test "$(cat "$worker_link/RELEASE-SHA")" = "$sha"
trap - ERR
echo "Activated release $sha; ERP preflight/postflight and MenuMinute readiness passed"
