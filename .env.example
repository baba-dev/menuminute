# ─── MenuMinute Environment Configuration ────────────────────────────────────
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.
#
# See docs/environment.md for full configuration details.

# ─── Core Application ────────────────────────────────────────────────────────

# Full URL of the application (no trailing slash)
# Local development: http://localhost:3000
# Production: https://menuminute.com
APP_URL=http://localhost:3000

# SQLite database file path (absolute or relative to project root)
# In production: use a persistent path outside the app release directory
# e.g. /var/data/menuminute/menuminute.sqlite
DATABASE_URL=./data/menuminute.sqlite

# NextAuth secret — generate with: openssl rand -base64 32
# REQUIRED in all environments
AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Node environment
NODE_ENV=development

# ─── Google Gemini AI ────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
# Used for: menu description enhancement, translation, OCR menu import
# Optional — AI features degrade gracefully when not configured
GEMINI_API_KEY=

# ─── NVIDIA NIM ──────────────────────────────────────────────────────────────
# https://build.nvidia.com/
# Used for: dish image generation (planned Phase B)
NVIDIA_API_KEY=

# ─── Cloudflare ──────────────────────────────────────────────────────────────
# https://dash.cloudflare.com/
# Used for: R2 media storage, Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# R2 Object Storage (production media)
# Local development uses local filesystem storage automatically
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=menuminute-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ─── Pexels Stock Photography ─────────────────────────────────────────────────
# https://www.pexels.com/api/
# Used for: licensed stock dish photography suggestions (planned Phase B)
PEXELS_API_KEY=

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Set to "true" to enable AI-powered features
# Keep "false" during Phase 0 — no billable API calls will be made
AI_FEATURES_ENABLED=false
IMAGE_GENERATION_ENABLED=false
