# Export these values for CLI scripts; Next.js also reads .env.local automatically.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://menuminute_app:isolated-ci-app-password@127.0.0.1:5432/menuminute_test
MIGRATION_DATABASE_URL=postgresql://foundation_owner:isolated-ci-owner-password@127.0.0.1:5432/menuminute_test
DATABASE_POOL_MAX=5
# Replace with output of openssl rand -hex 32. This placeholder is rejected in production.
AUTH_SECRET=development-only-replace-with-random-secret
# Select smtp or resend in production. The test transport is isolated to localhost/CI.
EMAIL_PROVIDER=smtp
EMAIL_FROM=food@bababuilds.com
SMTP_HOST=mx.bababuilds.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=food@bababuilds.com
SMTP_PASSWORD=
# Optional alternative; required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
AUTH_ALLOW_TEST_EMAIL=false
# Set secret at runtime and public key at Next.js build time.
TURNSTILE_SECRET_KEY=
# Required for real guest orders; generate independently and install in root-only web.env + Nginx snippet.
# ORDER_EDGE_SHARED_SECRET=<independently generated random 64-character hexadecimal value>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
REDIS_QUEUE_URL=redis://127.0.0.1:6379
REDIS_CACHE_URL=redis://127.0.0.1:6380
# Signed edge attestation for public orders and photos: configure Nginx before rollout.
PUBLIC_MEDIA_RATE_LIMIT_MAX=180
PUBLIC_MEDIA_RATE_LIMIT_GLOBAL_MAX=12000
PUBLIC_MEDIA_RATE_LIMIT_WINDOW_SECONDS=60
AI_FEATURES_ENABLED=false
# Ember is a server-only provider foundation in PR A: there is no public inference endpoint.
# All model IDs must be individually checked against provider capability + account entitlement.
AI_ORCHESTRATOR_ENABLED=false
# Server read-only chat remains OFF until metering, commercial rights and privacy gates are approved.
AI_ASSISTANT_READ_ONLY_ENABLED=false
# Explicitly confirmed, menu availability-only action surface, independent flag.
AI_ASSISTANT_ACTIONS_ENABLED=false
# Separate, stricter switch: Ember may prepare a menu PUBLISH for a person to confirm. Requires the
# actions flag. Draft price/description edits are covered by AI_ASSISTANT_ACTIONS_ENABLED alone.
AI_ASSISTANT_PUBLISH_ENABLED=false
AI_NVIDIA_ENABLED=false
# NVIDIA-only public dining concierge; exact allowed outlet IDs, not a public AI key.
# Both gate and an approved NVIDIA model/key must be configured before the entry appears.
AI_DINING_CONCIERGE_ENABLED=false
AI_DINING_CONCIERGE_OUTLET_IDS=
AI_NVIDIA_COMMERCIAL_APPROVED=false
AI_NVIDIA_MODEL=
AI_NVIDIA_TOOLS_VERIFIED=false
AI_CLOUDFLARE_ENABLED=false
AI_CLOUDFLARE_MODEL=
AI_CLOUDFLARE_TOOLS_VERIFIED=false
# REQUIRED when Ember is enabled: operator-approved pricing (micro-USD per million tokens) and a
# daily spend ceiling (micro-USD) for the provider in use. Use the real contract rates, never
# placeholders. Unset => every Ember turn fails with not_configured (and boot validation fails).
AI_EMBER_CLOUDFLARE_INPUT_MICROUSD_MTOK=
AI_EMBER_CLOUDFLARE_OUTPUT_MICROUSD_MTOK=
AI_EMBER_CLOUDFLARE_DAILY_CAP_MICROUSD=
AI_EMBER_NVIDIA_INPUT_MICROUSD_MTOK=
AI_EMBER_NVIDIA_OUTPUT_MICROUSD_MTOK=
AI_EMBER_NVIDIA_DAILY_CAP_MICROUSD=
IMAGE_GENERATION_ENABLED=false
# Phases F-G remain off until both the master gate and a bounded exact outlet allowlist are set.
PWA_OPERATIONAL_ENABLED=false
PWA_OPERATIONAL_OUTLET_IDS=
# Commercial POS provider support is independently gated in both runtime configuration and
# pos_finance_gates. Secrets are server-only; register /api/webhooks/stripe/pos in Stripe.
POS_STRIPE_ENABLED=false
POS_STRIPE_SECRET_KEY=
POS_STRIPE_WEBHOOK_SECRET=
# Hosted installations must remain cloud mode. Self-hosted mode must be explicitly provisioned.
COMMUNITY_EDITION=false
# Public demo kill switch (worker reset job + demo exceptions). Keep false unless the demo tenant is provisioned.
DEMO_MODE_ENABLED=false
DEMO_AI_DAILY_TURNS=150
DEMO_AI_SOURCE_TURNS_PER_10MIN=6
# Billing is disabled until dedicated DB identity and Razorpay credentials are provisioned.
RAZORPAY_ENABLED=false
RAZORPAY_KITCHEN_ENABLED=false
# BILLING_DATABASE_URL=postgresql://menuminute_billing:<dedicated-secret>@127.0.0.1:5432/menuminute
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_ORDERING_ID=
# RAZORPAY_PLAN_KITCHEN_ID=
# Optional integrations remain disabled unless configured and explicitly enabled.
GEMINI_API_KEY=
NVIDIA_API_KEY=
# Disabled until a real production/commercial NVIDIA entitlement is verified.
MENU_IMPORT_NVIDIA_ENABLED=false
NVIDIA_IMPORT_COMMERCIAL_APPROVED=false
# Exact enabled vision model identifier, e.g. from a reviewed NVIDIA NIM catalog card.
NVIDIA_IMPORT_MODEL=
# Optional worker-only cap: 1024–8192; set according to the configured vision NIM.
NVIDIA_IMPORT_MAX_OUTPUT_TOKENS=4096
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=menuminute-media
R2_ENDPOINT=
PEXELS_API_KEY=

# Worker process only. Never put the migration or web credential in this field.
WORKER_DATABASE_URL=postgresql://menuminute_worker:isolated-ci-worker-password@127.0.0.1:5432/menuminute_test

# Shared private media store for web and worker; outside immutable/public release paths.
MEDIA_STORAGE=local
MEDIA_ROOT=/var/lib/menuminute/media
MEDIA_OUTLET_BUDGET_BYTES=104857600

# PWA H: explicitly approved Web Push (default-off).
# Generate keys with P-256 ECDH; keep the 43-character private key secret on web/worker.
PWA_PUSH_ENABLED=false
PWA_PUSH_OUTLET_IDS=
PWA_PUSH_VAPID_PUBLIC_KEY=
PWA_PUSH_VAPID_PRIVATE_KEY=
PWA_PUSH_VAPID_SUBJECT=
